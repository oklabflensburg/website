# Copy to .env for local development. Never commit .env or production values.
# These intentionally fictional examples are REJECTED by the production server.
# All values below are public on the website, including in page payloads.
# Required: replace every value with reviewed provider details before deployment.
NUXT_PUBLIC_LEGAL_NAME="Example Civic Lab"
NUXT_PUBLIC_LEGAL_STREET="Example Street"
NUXT_PUBLIC_LEGAL_HOUSE_NUMBER="42"
NUXT_PUBLIC_LEGAL_POSTAL_CODE="12345"
NUXT_PUBLIC_LEGAL_CITY="Exampletown"
NUXT_PUBLIC_LEGAL_COUNTRY="Example Country"
NUXT_PUBLIC_LEGAL_EMAIL="legal@example.invalid"

# Optional: leave empty unless verified and applicable.
NUXT_PUBLIC_LEGAL_PHONE=""
NUXT_PUBLIC_LEGAL_REPRESENTED_BY=""
NUXT_PUBLIC_LEGAL_REGISTER_COURT=""
NUXT_PUBLIC_LEGAL_REGISTER_NUMBER=""
NUXT_PUBLIC_LEGAL_VAT_ID=""
# Privacy contact, not automatically a designated data protection officer.
NUXT_PUBLIC_LEGAL_PRIVACY_CONTACT_PERSON=""
# Only if section 18(2) MStV applies: full name AND serviceable postal address.
NUXT_PUBLIC_LEGAL_CONTENT_RESPONSIBLE=""

# Optional external hosting: setting any provider field enables the section.
# Then name, street, postal code, city and country are required; house number is optional.
# Fictional development examples below: replace for production or clear ALL hosting fields.
NUXT_PUBLIC_LEGAL_HOSTING_PROVIDER_NAME="Example Hosting"
NUXT_PUBLIC_LEGAL_HOSTING_PROVIDER_STREET="Example Avenue"
NUXT_PUBLIC_LEGAL_HOSTING_PROVIDER_HOUSE_NUMBER="7"
NUXT_PUBLIC_LEGAL_HOSTING_PROVIDER_POSTAL_CODE="12345"
NUXT_PUBLIC_LEGAL_HOSTING_PROVIDER_CITY="Exampletown"
NUXT_PUBLIC_LEGAL_HOSTING_PROVIDER_COUNTRY="Example Country"
# Exactly true or false; true only for a confirmed Art. 28 GDPR agreement.
# true also requires the provider details above. Legal prose stays in Content.
NUXT_PUBLIC_LEGAL_HOSTING_DPA="false"
